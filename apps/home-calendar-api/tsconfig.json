{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": ".build",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["functions/**/*", "sst.config.ts"],
  "exclude": ["node_modules", ".sst", ".build"]
}

    ["esp:D18", "lcd:SCK", "yellow", ["v:40", "h:130"]],
    ["esp:D5", "lcd:CS", "orange", ["v:50", "h:140"]],
    ["esp:D17", "lcd:DC", "purple", ["v:60", "h:150"]],
    ["esp:D16", "lcd:RST", "blue", ["v:70", "h:160"]],
    ["bat_sim:SIG", "esp:D36", "brown", ["v:0"]],
    ["bat_sim:GND", "esp:GND.2", "black", ["v:10"]],
    ["bat_sim:VCC", "esp:3V3", "red", ["v:20"]],
    ["status_led:A", "esp:D2", "green", ["h:0"]],
    ["status_led:C", "esp:GND.1", "black", ["h:10"]]
  ]

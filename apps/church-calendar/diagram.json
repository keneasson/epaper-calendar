{
  "version": 1,
  "author": "Church Schedule Display",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-ili9341",
      "id": "lcd",
      "top": -200,
      "left": 200,
      "attrs": { "flipHorizontal": "1" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "bat_sim",
      "top": 150,
      "left": -100,
      "attrs": { "value": "3700" }
    },
    {
      "type": "wokwi-led",
      "id": "status_led",
      "top": 50,
      "left": -80,
      "attrs": { "color": "green" }

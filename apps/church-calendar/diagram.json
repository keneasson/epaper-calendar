  "connections": [
    ["esp:TX0", "$serialMonitor:RX", "", []],
    ["esp:RX0", "$serialMonitor:TX", "", []],
    ["esp:GND.1", "lcd:GND", "black", ["v:20", "h:100"]],
    ["esp:3V3", "lcd:VCC", "red", ["v:10", "h:110"]],
